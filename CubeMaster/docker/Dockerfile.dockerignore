#
# Build-context filter for CubeMaster/docker/Dockerfile (context = repository root).
# The repo-root .dockerignore is tailored to docker/Dockerfile.builder and would
# exclude CubeMaster/ without these overrides. CubeMaster's go.mod replaces the
# local CubeLog, CubeDB and pkgs/proto modules via ../pkgs/CubeLog, ../CubeDB and
# ../pkgs/proto, so the image build must include all of them.
**
!CubeMaster
!CubeMaster/**
!pkgs
!pkgs/CubeLog
!pkgs/CubeLog/**
!pkgs/proto
!pkgs/proto/**
!CubeDB
!CubeDB/**
# Volume plugin host tools installer used by the runtime stage.
!deploy
!deploy/scripts
!deploy/scripts/docker-install-volume-deps.sh
# COS volume Controller plugin script + example conf (credentials via chart Secret).
!examples
!examples/volume
!examples/volume/cos
!examples/volume/cos/binary
!examples/volume/cos/binary/**
!examples/volume/cos/volume-cos.conf.example
# S3 volume Controller plugin: a Go module compiled in the builder stage, so the
# whole module (not just a script) has to be in the context.
!examples/volume/s3
!examples/volume/s3/**
examples/volume/s3/bin
