        "textMode": "auto"
      },
      "pluginVersion": "10.4.0",
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "$loki_datasource"
          },
          "editorMode": "code",
          "expr": "100 * sum(count_over_time({service_name=\"cubesandbox-sandbox\", cubesandbox_cluster_id=~\"${cluster:regex}\", host_name=~\"${node:regex}\"} | cubesandbox_sandbox_id=~`${sandbox_id:raw}` | log_iostream=`stderr` |~ `${log_query:raw}` [$__range])) / clamp_min(sum(count_over_time({service_name=\"cubesandbox-sandbox\", cubesandbox_cluster_id=~\"${cluster:regex}\", host_name=~\"${node:regex}\"} | cubesandbox_sandbox_id=~`${sandbox_id:raw}` |~ `${log_query:raw}` [$__range])), 1)",
          "queryType": "instant",
          "refId": "A"
        }
      ],
      "title": "Sandbox stderr share",
      "type": "stat"
    },
