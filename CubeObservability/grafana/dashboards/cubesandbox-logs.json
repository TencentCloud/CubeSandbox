      "datasource": {
        "type": "loki",
        "uid": "$loki_datasource"
      },
      "description": "Share of stderr lines over the dashboard time range (ignores Log Stream).",
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 20
              },
              {
                "color": "red",
                "value": 50
