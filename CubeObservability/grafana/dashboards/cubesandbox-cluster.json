      {
        "name": "cluster",
        "label": "Cluster",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "$datasource"
        },
        "query": {
          "query": "label_values({__name__=~\"cubesandbox_node_sandbox_count|cubesandbox_host_sandbox_memory_current_bytes|cubesandbox_guest_workload_memory_current_bytes\",job=\"cubesandbox-resource\"}, cluster)",
          "refId": "StandardVariableQuery"
        },
        "definition": "label_values({__name__=~\"cubesandbox_node_sandbox_count|cubesandbox_host_sandbox_memory_current_bytes|cubesandbox_guest_workload_memory_current_bytes\",job=\"cubesandbox-resource\"}, cluster)",
        "refresh": 2,
        "sort": 1,
        "hide": 0,
        "multi": false,
        "includeAll": false,
        "options": [],
        "skipUrlSync": false,
        "current": {}
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "About",
      "type": "text",
      "gridPos": {
        "h": 5,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "description": "### Cluster resource metrics\nHost Sandbox measures the host cgroup (including runtime); Guest Workload measures the workload inside the sandbox. These are sandbox resource totals, **not physical node/cluster capacity**, and must not be added together. CPU rates are cores; throttled time is seconds/second. Limits are sums of exported finite limits, not physical capacity. No sample is not zero. Guest rates exclude observed epoch-change windows; they are not exact rollback accounting. Dropdowns are scoped by cluster → node → sandbox → guest container, and refresh with the selected time range. Node inventory counters are node context, not a sandbox running-state count.",
      "options": {
        "mode": "markdown",
        "content": "### Cluster resource metrics\nHost Sandbox measures the host cgroup (including runtime); Guest Workload measures the workload inside the sandbox. These are sandbox resource totals, **not physical node/cluster capacity**, and must not be added together. CPU rates are cores; throttled time is seconds/second. Limits are sums of exported finite limits, not physical capacity. No sample is not zero. Guest rates exclude observed epoch-change windows; they are not exact rollback accounting. Dropdowns are scoped by cluster → node → sandbox → guest container, and refresh with the selected time range. Node inventory counters are node context, not a sandbox running-state count."
      }
    },
    {
      "id": 2,
      "title": "Inventory and sample coverage",
      "type": "row",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "description": "",
      "collapsed": false,
      "panels": []
    },
    {
      "id": 3,
      "title": "Node context: sandbox inventory / available samples",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 6
      },
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(max by (cluster,node) (cubesandbox_node_sandbox_count{job=\"cubesandbox-resource\",cluster=~\"${cluster:regex}\"}))",
          "legendFormat": "Inventory",
          "range": true,
          "instant": false,
          "format": "time_series"
        },
        {
          "refId": "B",
          "expr": "sum(max by (cluster,node) (cubesandbox_node_sandbox_available_count{job=\"cubesandbox-resource\",cluster=~\"${cluster:regex}\"}))",
          "legendFormat": "Available samples",
          "range": true,
          "instant": false,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No sample / not exported",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
