# build artifacts
*.o
*.pic.o
*.so
*.a
*.d

# app binaries
app/s3lvol_tgt/s3lvol_tgt
test/unit/*_ut
test/integration/*_test

# editors / IDEs
.vscode/
.idea/
*.swp
*~
compile_commands.json
.cache/

# local environment config (not committed)
.env
local.mk

# test scratch files
/tmp/
*.log
core.*
vgcore.*

# workbuddy
.workbuddy/
__pycache__/

# local agent working directory (project data, not committed)
.codebuddy/

# build dependencies (created by ./setup_dep.sh)
#
# Everything inside is ignored but the directory itself stays in the repo (via
# deps/.gitkeep), so a clone can see it exists and read deps/README.md without
# having to discover the convention from setup_dep.sh first.
/deps/*
!/deps/.gitkeep
!/deps/README.md

# release artifacts (generated by ./make_release.sh)
#
# The whole directory is ignored: 35 MB of binaries plus a tarball, rebuilt
# every time.
/release/

# build type stamp (maintained by mk/s3lvol.common.mk)
#
# The file name carries the current S3LVOL_BUILD_TYPE; switching the build type
# renames the file and forces every .o to rebuild.
/.build-*
