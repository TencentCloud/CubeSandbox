# Copy outside Git, chmod 600, edit and review before sourcing.
# Basic lifecycle tests use an existing platform; they never provision one.
export SDK_E2E_BACKENDS=cubesandbox
export CUBE_API_URL=http://127.0.0.1:13000
export CUBE_TEMPLATE_ID=REPLACE_WITH_READY_TEMPLATE
export WEBHOOK_TEST_RECEIVER_LOG=/srv/webhook-runs/review-01/receiver/requests.jsonl
export WEBHOOK_TEST_SUBSCRIPTION_ID=review-receiver
# Optional assertions for retry-once receiver mode and known pause resources:
# export WEBHOOK_TEST_EXPECT_RETRY=1
# export WEBHOOK_TEST_EXPECT_VCPU=1
# export WEBHOOK_TEST_EXPECT_MEMORY_MB=512

# Control tests require an already inventoried, isolated deployment.
# Never reuse an existing installation's units, binary paths or shared DB.
export WEBHOOK_TEST_CONTROL=0
# export WEBHOOK_TEST_RUN_ROOT=/srv/webhook-runs/review-01
# export WEBHOOK_TEST_RESOURCE_LABEL=webhook-test-review-01
# export WEBHOOK_TEST_MASTER_UNIT=webhook-1903-review-master.service
# export WEBHOOK_TEST_MASTER_BINARY="$WEBHOOK_TEST_RUN_ROOT/bin/cubemaster"
# export WEBHOOK_TEST_MASTER_CONFIG="$WEBHOOK_TEST_RUN_ROOT/master/conf.yaml"
# export WEBHOOK_TEST_MASTER_URL=http://127.0.0.1:18089
# export WEBHOOK_TEST_RECEIVER_MODE="$WEBHOOK_TEST_RUN_ROOT/receiver/mode"
# export WEBHOOK_TEST_HTTP_FAILURES=1
# Second bounded receiver for fanout/filter (no second Master):
# export WEBHOOK_TEST_CONCURRENT_RECEIVER_URL=http://127.0.0.1:18097/events
# export WEBHOOK_TEST_CONCURRENT_RECEIVER_LOG="$WEBHOOK_TEST_RUN_ROOT/receiver/second.jsonl"

# Node/local XFS and destroy boundaries:
# export WEBHOOK_TEST_NODE_FAULTS=1
# export WEBHOOK_TEST_NODE_UNIT=webhook-1903-review-node.service
# export WEBHOOK_TEST_NODE_BINARY="$WEBHOOK_TEST_RUN_ROOT/bin/cubelet"
# export WEBHOOK_TEST_NODE_XFS_ROOT="$WEBHOOK_TEST_RUN_ROOT/node/storage/xfs"
# export WEBHOOK_TEST_EGRESS_CONTAINER=webhook-1903-review-egress
# export WEBHOOK_TEST_LCM_UNIT=webhook-1903-review-lcm.service
# export WEBHOOK_TEST_NODE_CLI="$WEBHOOK_TEST_RUN_ROOT/bin/cubecli"
# export WEBHOOK_TEST_NODE_SOCKET="$WEBHOOK_TEST_RUN_ROOT/node/cubelet.sock"
# export WEBHOOK_TEST_PROXY_FAULTS=1
# export WEBHOOK_TEST_PROXY_CONTAINER=webhook-1903-review-cubeproxy

# Business Redis remains a platform dependency. Only a dedicated existing
# business RESP fault fixture uses this directory; there is no notification Redis.
# export WEBHOOK_TEST_BUSINESS_PROXY_DIR="$WEBHOOK_TEST_RUN_ROOT/proxy-business"
# export WEBHOOK_TEST_BUSINESS_REDIS_CONTAINER=webhook-1903-review-business-redis
# export WEBHOOK_TEST_DATABASE_FAULTS=1
# export WEBHOOK_TEST_MYSQL_CONTAINER=webhook-1903-review-mysql
# DB fault tests require schema wh_test_[0-9_]+ and user webhook_test_1903.

# Run separately with real READY XFS/S3 templates, never relabel one backend:
# export WEBHOOK_TEST_STORAGE_BACKEND=xfs
# For S3 local failure only (forward / snapshot-error; no upload proxy):
# export WEBHOOK_TEST_STORAGE_PROXY_MODE="$WEBHOOK_TEST_RUN_ROOT/proxy-local-snapshot/mode"

# TLS: three real endpoints forwarding to the same receiver evidence log.
# Scope SSL_CERT_FILE to the dedicated Master; never disable verification.
# export WEBHOOK_TEST_TLS_CA="$WEBHOOK_TEST_RUN_ROOT/tls/ca.crt"
# export WEBHOOK_TEST_TLS_TRUSTED_URL=https://127.0.0.1:18443/events
# export WEBHOOK_TEST_TLS_UNTRUSTED_URL=https://127.0.0.1:18444/events
# export WEBHOOK_TEST_TLS_WRONG_HOST_URL=https://127.0.0.1:18445/events

# Go-only isolated business lifecycle Redis fixture (DB 8, not live data):
# export WEBHOOK_TEST_BUSINESS_REDIS_ADDR=127.0.0.1:16379
# export WEBHOOK_TEST_BUSINESS_REDIS_PASSWORD=REPLACE_WITH_TEST_PASSWORD
# WEBHOOK_TEST_CONFIG_HELPER / FIXTURE_PROCESS / ASYNC_QUEUE_CHILD are internal
# child-process selectors set by Go tests, not deployment options.
