# Copy OUTSIDE the checkout, chmod 600, edit, then source in the test shell.
# Paths and ports below are examples, not required installation locations.
export WEBHOOK_P6_RUN_ROOT=/srv/webhook-runs/review-01
export WEBHOOK_P6_RESOURCE_LABEL=webhook-p6-review-01
export SDK_E2E_BACKENDS=cubesandbox
export CUBE_API_URL=http://127.0.0.1:13000
export CUBE_TEMPLATE_ID=REPLACE_WITH_READY_TEMPLATE
export WEBHOOK_P6_MASTER_UNIT=webhook-1903-review-master.service
export WEBHOOK_P6_MASTER_BINARY="$WEBHOOK_P6_RUN_ROOT/bin/cubemaster"
export WEBHOOK_P6_MASTER_CONFIG="$WEBHOOK_P6_RUN_ROOT/master/conf.yaml"
export WEBHOOK_P6_MASTER_URL=http://127.0.0.1:18089
export WEBHOOK_P6_MASTER_DEBUG_URL=http://127.0.0.1:18090
export WEBHOOK_P6_REDIS_CONTAINER=webhook-1903-review-redis
export WEBHOOK_P6_REDIS_PASSWORD=REPLACE_WITH_TEST_PASSWORD
export WEBHOOK_P6_REDIS_DB=6
export WEBHOOK_P6_SUBSCRIPTION_ID=review-receiver
export WEBHOOK_P6_RECEIVER_URL=http://127.0.0.1:18096/events
export WEBHOOK_P6_RECEIVER_MODE="$WEBHOOK_P6_RUN_ROOT/receiver/mode"
export WEBHOOK_P6_RECEIVER_LOG="$WEBHOOK_P6_RUN_ROOT/receiver/requests.jsonl"
# Control/fault suites are opt-in; do not enable all scenarios together.
export WEBHOOK_P6_CONTROL=0

