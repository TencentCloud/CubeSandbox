# Copy this file to .env before running live E2E tests.
# pytest automatically loads tests/e2e/sdk_compat/.env when it exists.
# Exported shell variables take precedence over values in .env.
# The lightweight loader supports one KEY=VALUE entry per line only; multiline
# quoted values are not supported. Export complex secrets in the shell instead.

# Select one or more backends, separated by commas. Supported values are
# cubesandbox and e2b. The cubesandbox backend uses the local SDK source by
# default; the e2b backend requires installing e2b-code-interpreter or e2b.
SDK_E2E_BACKENDS=cubesandbox
# Required only when SDK_E2E_BACKENDS includes e2b. Do not use CUBE_API_KEY as
# a fallback: this is the API key consumed by the E2B SDK.
# E2B_API_KEY=your-e2b-api-key
# Enable E2B's client-side e2b_* API key format check. Keep false for
# self-hosted deployments that issue keys in a different format.
SDK_E2E_E2B_VALIDATE_API_KEY=false

# CubeSandbox control-plane endpoint used by the adapter, preflight,
# diagnostics, and cleanup.
CUBE_API_URL=http://127.0.0.1:3000
# READY template used when creating test sandboxes.
CUBE_TEMPLATE_ID=tpl-xxxxxxxxxxxxxxxxxxxxxxxx
# Optional CubeSandbox API key. It is not used as E2B_API_KEY.
# CUBE_API_KEY=your-cube-api-key

# CubeProxy routing for sandbox data-plane traffic. Set CUBE_PROXY_NODE_IP when
# the test runner cannot resolve the wildcard sandbox hostname.
# CUBE_PROXY_NODE_IP=10.0.1.2
# HTTP port exposed by CubeProxy.
CUBE_PROXY_PORT_HTTP=80
# Wildcard domain used to construct sandbox hostnames.
CUBE_SANDBOX_DOMAIN=cube.app

# Operation timeouts in seconds. DEFAULT covers connect/resume and cleanup;
# API covers control-plane HTTP requests; CREATE, COMMAND, and RUN_CODE cover
# their respective operations.
SDK_E2E_DEFAULT_TIMEOUT=120
SDK_E2E_API_TIMEOUT=5
SDK_E2E_CREATE_TIMEOUT=120
# Retry sandbox create when the scheduler is transiently out of capacity
# ("no more resource", error code 130597). RETRIES is extra attempts after the
# first (0 disables); BACKOFF is the base seconds, grown exponentially with full
# jitter and capped at BACKOFF_MAX. Note BACKOFF_MAX<=0 disables the per-delay
# cap (delays grow up to an internal 3600s ceiling); it does NOT mean "no
# backoff" — leave it at a positive value unless you intend uncapped growth.
# BUDGET is the total wall-clock seconds spent *sleeping* across all retries for
# one create (0 disables). It caps only the cumulative backoff sleep, not the
# create() calls: each attempt can still run up to CREATE_TIMEOUT, so a
# slow-to-reject scheduler can take ~ (RETRIES+1) * CREATE_TIMEOUT + BUDGET per
# test; on the fast HTTP-500 rejection path it bounds per-create retry time.
SDK_E2E_CREATE_CAPACITY_RETRIES=5
SDK_E2E_CREATE_CAPACITY_BACKOFF=2
SDK_E2E_CREATE_CAPACITY_BACKOFF_MAX=30
SDK_E2E_CREATE_CAPACITY_BUDGET=90
SDK_E2E_COMMAND_TIMEOUT=30
SDK_E2E_RUN_CODE_TIMEOUT=60
SDK_E2E_NETWORK_PROBE_TIMEOUT=5
# Public TCP endpoints used by network policy tests. Configure targets that are
# reachable and stable from the test environment.
SDK_E2E_TCP_TARGET_IP=8.8.8.8
SDK_E2E_TCP_TARGET_PORT=53
SDK_E2E_ALTERNATE_TCP_TARGET_IP=1.1.1.1
# Exposed sandbox HTTP endpoint used by restrict-public-access inbound tests.
# The default targets envd health on the standard exposed envd port. Override
# these values when the template exposes a different HTTP service. envd
# /health normally returns HTTP 204 with an empty body.
# The default public URL uses HTTP, so traffic access tokens are sent in
# cleartext. Use an HTTPS endpoint for cross-network or multi-tenant CI.
SDK_E2E_PUBLIC_ACCESS_PORT=49983
SDK_E2E_PUBLIC_ACCESS_PATH=/health
SDK_E2E_PUBLIC_ACCESS_EXPECTED_STATUS=204
SDK_E2E_PUBLIC_ACCESS_EXPECTED_BODY=

# When E2B tests target a local/self-hosted CubeSandbox deployment, sandbox
# command/file/run_code traffic may use HTTPS with a private CA. Point
# SSL_CERT_FILE to that CA bundle; do not disable TLS verification.
# SSL_CERT_FILE=/root/.local/share/mkcert/rootCA.pem

# Keep the main sandbox only when setup/call fails. Passed, skipped,
# teardown-only failures, and peer/control sandboxes are still cleaned up.
# Set back to false for normal runs.
SDK_E2E_KEEP_SANDBOX_ON_FAILURE=false
# Print every SDK adapter operation. Failed tests include a recent trace even
# when this is false.
# SDK_E2E_TRACE=true
# Skip requires_internet tests when the runner has no stable public egress.
# SDK_E2E_SKIP_INTERNET_TESTS=false
# Directory for JSONL event reports. Serial runs write events.jsonl; pytest-xdist
# workers each write events-gw0.jsonl, events-gw1.jsonl, ...
SDK_E2E_REPORT_DIR=reports/sdk-dual
# pytest-xdist worker count for --run-e2e. Parallelism is opt-in: unset (or
# 0/1/no/off) runs serial. Set an integer / auto / logical to fan out; -n wins.
# SDK_E2E_WORKERS=auto
# Max concurrent live template builds across xdist workers. Default 1 (fully
# serialized so results match a serial run); <1 or non-integer falls back to 1.
# POSIX-only (no-op without fcntl).
# SDK_E2E_TEMPLATE_BUILD_CONCURRENCY=1
# Per-predecessor ceiling (seconds) on waiting for a build slot before a worker
# gives up and builds unthrottled, so a wedged peer cannot stall the suite. The
# effective wait scales by the worker count. Default 1800; <=0 waits forever.
# SDK_E2E_TEMPLATE_BUILD_WAIT=1800

# Platform-managed lifecycle (auto-pause / auto-resume / auto-kill) requires
# cube-proxy plus cube-lifecycle-manager coordination. Keep disabled for PR
# smoke; enable for lifecycle regression environments.
# SDK_E2E_PLATFORM_LIFECYCLE=true
# Idle timeout before platform lifecycle action.
# SDK_E2E_PLATFORM_LIFECYCLE_IDLE_TIMEOUT=30
# Extra grace period after the configured idle timeout.
# SDK_E2E_PLATFORM_LIFECYCLE_WAIT_MARGIN=20
# Maximum polling window for observing lifecycle transitions.
# SDK_E2E_PLATFORM_LIFECYCLE_POLL_TIMEOUT=45
# CubeProxy admin port used by the platform health probe.
# CUBE_PROXY_ADMIN_PORT=8082

# Volume Plugin cases (CRUD + sandbox volumeMounts bind/unbind).
# Default install S3 plugin + MinIO; platform >= 0.6.0; Python SDK cubesandbox >= 0.6.0.
# Guide: https://github.com/TencentCloud/CubeSandbox/blob/master/examples/volume/s3/README.md
# Runs with --run-e2e; set false to skip on clusters without the plugin.
# SDK_E2E_VOLUME_PLUGIN=false
# Driver/plugin name passed to POST /volumes (default s3).
# SDK_E2E_VOLUME_DRIVER=s3
# Max seconds to wait for delete-while-bound 409 / post-unbind 204.
# SDK_E2E_VOLUME_REFCOUNT_WAIT=60

# Override the local CubeSandbox Python SDK path when testing an unreleased
# checkout or a custom SDK build.
# CUBE_PYTHON_SDK_PATH=/path/to/CubeSandbox/sdk/python

# Node-local cubecli envd-log checks (cases/lifecycle/test_sandbox_envd_logs.py).
# Single-node only: multi-node clusters skip. Defaults look for cubecli next to
# Cubelet and the Cubelet unix socket; override when the binaries live elsewhere.
# CUBECLI=/usr/local/services/cubetoolbox/Cubelet/bin/cubecli
# CUBELET_ADDRESS=/data/cubelet/cubelet.sock
