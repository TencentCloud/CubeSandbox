# CubeAPI 地址与 CubeProxy 所在节点的可访问 IP；两者可以不是同一节点。
export CUBE_API_URL=http://198.51.100.10:3000
export CUBE_PROXY_NODE_IP=198.51.100.11
# 如果集群启用了鉴权，取消下一行注释并填写密钥。
# export CUBE_API_KEY=

# 控制节点名与调度 IP。两个脚本均直接在 c1 上执行。
# CUBE_CONTROL_NODE 是运行 Docker/MySQL 和 cubeopscli 的主机名，不能省略。
export CUBE_CONTROL_NODE=c1
export CUBE_NODES="c1=198.51.100.10,c2=198.51.100.12,c3=198.51.100.13"

# 已构建完成的 JFS 模板和测试节点
export JFS_TEMPLATE=tpl-replace-me
export PERF_ORIGIN=c2
export PERF_TARGET=c3

# 测试结果
export PERF_OUTPUT=/tmp/jfs-perf-result.json
