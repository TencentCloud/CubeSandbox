{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "datasource": {
        "type": "tempo",
        "uid": "${DS_TEMPO}"
      },
      "description": "Find up to 50 traces whose spans carry this CubeSandbox sandbox ID.",
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "^[Tt]race[ _]?[Ii][Dd]$"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Show trace in this dashboard",
                    "url": "/d/${__dashboard.uid}?${__url_time_range}&var-DS_TEMPO=${DS_TEMPO:percentencode}&var-sandbox_id=${sandbox_id:percentencode}&var-trace_id=${__value.raw}",
                    "targetBlank": false
                  }
                ]
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 7,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "pluginVersion": "10.4.18",
      "targets": [
        {
          "datasource": {
            "type": "tempo",
            "uid": "${DS_TEMPO}"
          },
          "limit": 50,
          "query": "{ span.cube.sandbox_id = ${sandbox_id:doublequote} }",
          "queryType": "traceql",
          "refId": "A",
          "tableType": "traces"
        }
      ],
      "title": "Sandbox traces",
      "transformations": [],
      "type": "table"
    },
    {
      "datasource": {
        "type": "tempo",
        "uid": "${DS_TEMPO}"
      },
      "description": "Select a Trace ID from the results or enter a Trace ID directly.",
      "gridPos": {
        "h": 16,
        "w": 24,
        "x": 0,
        "y": 7
      },
      "id": 2,
      "options": {},
      "targets": [
        {
          "datasource": {
            "type": "tempo",
            "uid": "${DS_TEMPO}"
          },
          "query": "$trace_id",
          "queryType": "traceql",
          "refId": "A"
        }
      ],
      "title": "Trace details",
      "type": "traces"
    }
  ],
  "refresh": "",
  "schemaVersion": 39,
  "tags": [
    "cubesandbox",
    "tracing"
  ],
  "templating": {
    "list": [
      {
        "current": {},
        "hide": 0,
        "includeAll": false,
        "label": "Tempo datasource",
        "multi": false,
