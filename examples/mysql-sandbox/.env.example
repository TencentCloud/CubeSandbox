# Required: Cube API server address
E2B_API_URL="http://127.0.0.1:3000"

# Required: API key for authentication (set to any non-empty value for local dev)
E2B_API_KEY="<your-api-key>"

# Required: template ID obtained from template creation
CUBE_TEMPLATE_ID="<your-template-id>"

# Optional: only needed when using Cube's built-in mkcert certificate
SSL_CERT_FILE="/root/.local/share/mkcert/rootCA.pem"

# Optional: MySQL database connection (for run_query.py and multi_query.py)
DB_HOST="localhost"
DB_USER="root"
DB_PASSWORD=""
DB_NAME="test_db"
