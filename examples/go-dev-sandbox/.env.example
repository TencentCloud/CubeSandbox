# Required: Cube API server address
export CUBE_API_URL="http://<your-node-ip>:3000"

# Required: any non-empty value satisfies the SDK check
export CUBE_API_KEY="e2b_000000"

# Required: template ID printed by `cubemastercli tpl create-from-image`
export CUBE_TEMPLATE_ID="<your-template-id>"

# Required on deployments without wildcard DNS for *.cube.app: the CubeProxy
# node the SDK should connect to directly. Use 127.0.0.1 for a single-node
# install. Without it the SDK cannot reach <port>-<sandbox_id>.cube.app.
export CUBE_PROXY_NODE_IP="127.0.0.1"

# Optional: only needed when using Cube's built-in cube.app mkcert certificate
export SSL_CERT_FILE="/root/.local/share/mkcert/rootCA.pem"

# Optional, fanout_build.py only: cross-compile targets (one sandbox each) and
# the workspace root, which must sit under an allowed host-mount prefix
# (/data/shared/ by default).
#export FANOUT_TARGETS="linux/amd64,linux/arm64"
#export FANOUT_WORK_DIR="/data/shared/go-fanout"
