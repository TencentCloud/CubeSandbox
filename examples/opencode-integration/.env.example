# CubeAPI endpoint. Use CubeAPI, not CubeProxy.
E2B_API_URL="http://<cube-host>:3000"

# Any non-empty value in unauthenticated local development.
E2B_API_KEY="e2b_000000"

# Template created from this example's Dockerfile.
CUBE_TEMPLATE_ID="<template-id>"

# Tencent TokenHub Hy3.
HY3_API_KEY="<your-tokenhub-api-key>"
HY3_BASE_URL="https://tokenhub.tencentmaas.com/v1"
HY3_MODEL="hy3"

# Optional limits.
# OPENCODE_SANDBOX_TIMEOUT="1800"
# OPENCODE_EXEC_TIMEOUT="900"
# OPENCODE_WORKSPACE="/workspace"

# Optional CubeEgress CA bundle override for network_policy.py.
# OPENCODE_CA_BUNDLE="/etc/ssl/certs/ca-certificates.crt"
