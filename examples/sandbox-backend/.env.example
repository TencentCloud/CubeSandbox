# CubeSandbox native SDK configuration (see sdk/python/cubesandbox/_config.py)
CUBE_API_URL=http://127.0.0.1:3000
CUBE_TEMPLATE_ID=tpl-xxxxxxxxxxxxxxxx

# Optional overrides
# CUBE_SANDBOX_USER=root           # user envd runs commands as inside the sandbox
# CUBE_SANDBOX_TIMEOUT=1800        # sandbox TTL in seconds, refreshed on every reconnect
# CUBE_EXEC_TIMEOUT=120            # default per-command timeout in seconds
# CUBE_HOOK_STATE_DIR=~/.cache/cubesandbox-hook   # where session->sandbox_id mappings live
