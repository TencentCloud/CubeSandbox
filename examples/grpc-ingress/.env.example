# Cube API (control plane — create/delete sandbox)
export CUBE_API_URL="http://<your-node-ip>:3000"
export CUBE_TEMPLATE_ID="<your-template-id>"

# CubeProxy plaintext gRPC ingress
export CUBE_PROXY_NODE_IP="<cube-proxy-ip>"
export CUBE_PROXY_GRPC_PORT=9091

# envd listens on 49983 in standard templates
export ENVD_PORT=49983
