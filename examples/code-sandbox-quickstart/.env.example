# Required: Cube API server address
export E2B_API_URL="http://<your-node-ip>:3000"

# Required: any non-empty value satisfies the SDK check
export E2B_API_KEY="e2b_000000"

# Required: template ID obtained from Step 1 (create-from-image)
export CUBE_TEMPLATE_ID="<your-template-id>"

# Local dev (outside cluster): route E2B SDK data-plane via examples/e2b-dev-sidecar
# (requires the full CubeSandbox repo — not just this quickstart directory).
# CubeProxy is usually HTTPS on :443 (or :8080 / :9090); dev-env often uses :11443.
# export CUBE_REMOTE_PROXY_BASE="https://<your-node-ip>:443"
# export CUBE_REMOTE_PROXY_VERIFY_SSL="false"

# Optional: per-attempt timeout (seconds) for apply_create_time_envs() POST /init
# (default 5; increase on slow laptop → sidecar → CubeProxy → envd paths)
# export CUBE_ENVD_INIT_ATTEMPT_TIMEOUT_S="5"

# Optional: only needed when using Cube's built-in cube.app mkcert certificate
export SSL_CERT_FILE="/root/.local/share/mkcert/rootCA.pem"
