# CubeSandbox native SDK
CUBE_API_URL="http://<your-node-ip>:3000"
# Set only when CubeAPI authentication is enabled.
# CUBE_API_KEY="<your-cube-api-key>"
CUBE_TEMPLATE_ID="<your-template-id>"
# Use a direct CubeProxy IP when wildcard DNS is unavailable.
CUBE_PROXY_NODE_IP="<your-node-ip>"
# CUBE_PROXY_PORT_HTTP=8081

# The model runs in the host-side Agno harness. Its credentials are never copied
# into the MicroVM by this example.
OPENAI_API_KEY="<your-openai-compatible-api-key>"
OPENAI_BASE_URL="<your-openai-compatible-base-url>"
AGNO_MODEL="gpt-4o-mini"
