# ── cube-lifecycle-manager (CLM) Webhook Config ──────────────────────────
# These variables configure the CLM side. Set them in the CLM process
# environment (systemd EnvironmentFile, docker -e, etc.), not this file —
# this file documents what the receiver expects CLM to send with.

# Target URL(s) for the receiver — comma-separated for multiple endpoints.
# Each URL is an endpoint CLM will POST sandbox lifecycle events to.
export CUBE_LCM_WEBHOOK_URLS="http://localhost:8081/webhook"

# Event filter — "*" for all, or a comma-separated list of:
#   sandbox.created, sandbox.deleted, sandbox.paused,
#   sandbox.resumed, sandbox.timeout.updated
export CUBE_LCM_WEBHOOK_EVENTS="*"

# Optional: shared secret for HMAC-SHA256 payload signing.
# Must match WEBHOOK_SECRET set when starting receiver.py; empty = unsigned.
export CUBE_LCM_WEBHOOK_SECRET="my-shared-secret"

# Optional tuning knobs (defaults shown; omit to use the defaults):
# export CUBE_LCM_WEBHOOK_TIMEOUT="10s"    # per-request HTTP timeout
# export CUBE_LCM_WEBHOOK_MAX_RETRIES="2"  # retries after the first attempt (3 total)
