# --- CubeSandbox connection ---

# Required: CubeAPI address (use CubeAPI, not CubeProxy).
export E2B_API_URL="http://<cube-host>:3000"

# Required: any non-empty value in local dev; a real key when auth is enabled.
export E2B_API_KEY="e2b_000000"

# Required: template built from this example's Dockerfile.
export CUBE_TEMPLATE_ID="<your-template-id>"

# Optional: only when talking to CubeProxy over HTTPS with Cube's mkcert cert.
# export SSL_CERT_FILE="/root/.local/share/mkcert/rootCA.pem"

# --- Security policy overrides ---

# Uncomment to restrict sandbox egress (default: internet allowed).
# This is equivalent to passing allow_internet_access=False at creation.
# export CUBE_DEFAULT_ALLOW_INTERNET="false"

# Uncomment to set a default resource limit (memory in MB).
# export CUBE_DEFAULT_MEMORY_LIMIT_MB="512"

# Uncomment to set a default CPU limit (vCPU count).
# export CUBE_DEFAULT_CPU_LIMIT="1.0"
