# CubeSandbox connection
E2B_API_URL=http://127.0.0.1:3000
E2B_API_KEY=e2b_000000
CUBE_API_URL=http://127.0.0.1:3000
CUBE_TEMPLATE_ID=tpl-3f5bfab2f5db497d8c5cf1b8

# Optional: host-side Claude Code PreToolUse hook overrides
# CUBE_SANDBOX_USER=root
# CUBE_SANDBOX_TIMEOUT=1800
# CUBE_EXEC_TIMEOUT=120
# CUBE_HOOK_STATE_DIR=~/.cache/cubesandbox-hook
# CUBE_PROXY_NODE_IP=127.0.0.1
# CUBE_PROXY_PORT_HTTP=80
# CUBE_SANDBOX_DOMAIN=cube.app

# LLM provider (use "deepseek" for DeepSeek API)
CC_PROVIDER=deepseek
CC_MODEL=deepseek-v4-pro

# DeepSeek API (default)
ANTHROPIC_AUTH_TOKEN=sk-your-deepseek-api-key
ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic

# Anthropic API (alternative)
# ANTHROPIC_AUTH_TOKEN=sk-ant-your-anthropic-api-key
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# CC_MODEL=claude-sonnet-4-6

# Claude Code requires an Anthropic-protocol endpoint. OpenAI-compatible
# endpoints are not supported directly by these examples.

# Optional: trust CubeProxy CA cert (uncomment if using HTTPS)
# SSL_CERT_FILE=/usr/local/share/ca-certificates/cube-ca.crt
# NODE_EXTRA_CA_CERTS=/usr/local/share/ca-certificates/cube-ca.crt
