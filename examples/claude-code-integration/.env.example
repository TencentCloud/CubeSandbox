# CubeSandbox connection (the cubesandbox SDK is E2B-compatible)
E2B_API_URL=http://127.0.0.1:3000
E2B_API_KEY=e2b_000000
CUBE_API_URL=http://127.0.0.1:3000

# Template the PreToolUse hook launches sandboxes from (required)
CUBE_TEMPLATE_ID=tpl-3f5bfab2f5db497d8c5cf1b8

# Optional host-side PreToolUse hook overrides
# CUBE_SANDBOX_USER=root
# CUBE_SANDBOX_TIMEOUT=1800
# CUBE_EXEC_TIMEOUT=120
# CUBE_HOOK_STATE_DIR=~/.cache/cubesandbox-hook
