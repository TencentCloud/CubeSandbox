# ---- CubeSandbox (native SDK: from cubesandbox import Sandbox) ----
# (optional) CubeAPI control-plane URL; defaults to http://127.0.0.1:3000
CUBE_API_URL="http://<your-node-ip>:3000"
# (optional) only for an auth-enabled CubeAPI; the SDK sends no auth header when unset
CUBE_API_KEY="<your-cube-api-key>"
# (required) sandbox template used by the demo (the official `sandbox-code` image)
CUBE_TEMPLATE_ID="<your-template-id>"
# (optional) direct IP to reach CubeProxy; unset = use normal DNS
CUBE_PROXY_NODE_IP="<your-node-ip>"
# (optional) CubeProxy HTTP port; defaults to 80. Uncomment only if the proxy
# listens on a non-default port.
# CUBE_PROXY_PORT_HTTP=8081
# (optional) self-signed CA PEM path for the CubeAPI HTTPS endpoint. The demo
# exports it as SSL_CERT_FILE (process-global), so the bundle must also include
# public root CAs or the LLM endpoint below will fail TLS verification too.
# CUBE_SSL_CERT_FILE="/path/to/ca-cert.pem"

# ---- LLM (any OpenAI-compatible endpoint) ----
# (required) API key for the OpenAI-compatible endpoint
OPENAI_API_KEY="<your-api-key>"
# (optional) endpoint base URL; defaults to https://tokenhub.tencentmaas.com/v1
OPENAI_BASE_URL="<your-openai-compatible-endpoint>"
# (optional) model name available at that endpoint; defaults to deepseek-v3
MODEL_NAME="<your-chat-model>"
