# CubeAPI address. For a local deployment this is commonly http://<node-ip>:3000.
E2B_API_URL=http://127.0.0.1:3000
# Cube Sandbox accepts any non-empty API key in a default local deployment.
E2B_API_KEY=e2b_local_development_key
# Set this after `cubemastercli tpl create-from-image ...` reaches READY.
CUBE_TEMPLATE_ID=tpl_replace_me
