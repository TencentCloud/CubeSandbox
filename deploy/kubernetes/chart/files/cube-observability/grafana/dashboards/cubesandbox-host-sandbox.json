    {
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "description": "Uses cubesandbox_node_sandbox_count on a newer Cubelet and falls back to the number of currently exported sandbox resource series on older versions.",
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "id": 6,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "sum(cubesandbox_node_sandbox_count{cluster=~\"$cluster\",node=~\"$node\"} or on (cluster, node) count by (cluster, node) (cubesandbox_host_sandbox_memory_current_bytes{job=\"cubesandbox-resource\",cluster=~\"$cluster\",node=~\"$node\"}))",
          "instant": true,
          "legendFormat": "sandboxes",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Total sandboxes",
      "type": "stat"
    },
