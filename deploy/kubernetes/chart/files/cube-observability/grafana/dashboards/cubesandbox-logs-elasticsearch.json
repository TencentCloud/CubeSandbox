            "legend": {
              "calcs": [
                "sum",
                "lastNotNull"
              ],
              "displayMode": "table",
              "placement": "right",
              "showLegend": true
            },
            "tooltip": {
              "mode": "multi",
              "sort": "desc"
            }
          },
          "targets": [
            {
              "bucketAggs": [
                {
                  "field": "cubesandbox_component_name.keyword",
                  "id": "3",
                  "settings": {
                    "min_doc_count": "1",
                    "order": "desc",
                    "orderBy": "_count",
                    "size": "10"
                  },
                  "type": "terms"
                },
                {
                  "field": "@timestamp",
                  "id": "2",
                  "settings": {
                    "interval": "auto",
                    "min_doc_count": "0",
                    "trimEdges": "0"
                  },
                  "type": "date_histogram"
                }
              ],
              "datasource": {
                "type": "elasticsearch",
                "uid": "$es_datasource"
              },
              "metrics": [
                {
                  "id": "1",
                  "type": "count"
                }
              ],
              "query": "cubesandbox_log_source.keyword:\"component\" AND cubesandbox_component_name.keyword:$component AND cubesandbox_cluster_id.keyword:$cluster AND host_name.keyword:$node AND ($log_query)",
              "refId": "A",
              "timeField": "@timestamp"
            }
          ],
          "title": "Component log volume",
          "type": "timeseries"
        },
        {
          "datasource": {
            "type": "elasticsearch",
            "uid": "$es_datasource"
          },
          "description": "Component log lines matching error, fatal, or panic.",
          "fieldConfig": {
            "defaults": {
              "custom": {
                "drawStyle": "bars",
                "fillOpacity": 60,
                "lineWidth": 1
              },
              "unit": "short"
            },
            "overrides": []
          },
          "gridPos": {
            "h": 7,
            "w": 12,
            "x": 12,
            "y": 24
          },
          "id": 21,
          "options": {
            "legend": {
              "calcs": [
                "sum",
                "lastNotNull"
              ],
              "displayMode": "table",
              "placement": "right",
              "showLegend": true
            },
            "tooltip": {
              "mode": "multi",
              "sort": "desc"
            }
          },
          "targets": [
            {
              "bucketAggs": [
                {
                  "field": "cubesandbox_component_name.keyword",
                  "id": "3",
                  "settings": {
                    "min_doc_count": "1",
                    "order": "desc",
                    "orderBy": "_count",
                    "size": "10"
                  },
                  "type": "terms"
                },
                {
                  "field": "@timestamp",
                  "id": "2",
                  "settings": {
                    "interval": "auto",
                    "min_doc_count": "0",
                    "trimEdges": "0"
                  },
                  "type": "date_histogram"
                }
              ],
              "datasource": {
                "type": "elasticsearch",
                "uid": "$es_datasource"
              },
              "metrics": [
                {
                  "id": "1",
                  "type": "count"
                }
              ],
              "query": "cubesandbox_log_source.keyword:\"component\" AND cubesandbox_component_name.keyword:$component AND cubesandbox_cluster_id.keyword:$cluster AND host_name.keyword:$node AND ($log_query) AND Body:(error OR fatal OR panic)",
              "refId": "A",
              "timeField": "@timestamp"
            }
          ],
          "title": "Component error-like log volume",
          "type": "timeseries"
        },
        {
          "datasource": {
            "type": "elasticsearch",
            "uid": "$es_datasource"
          },
          "description": "Component container logs for the selected components.",
          "gridPos": {
            "h": 12,
            "w": 24,
            "x": 0,
            "y": 31
          },
          "id": 22,
          "options": {
            "dedupStrategy": "none",
            "enableLogDetails": true,
            "prettifyLogMessage": false,
            "showCommonLabels": false,
            "showLabels": true,
            "showTime": true,
            "sortOrder": "Descending",
            "wrapLogMessage": true
          },
          "targets": [
            {
              "bucketAggs": [
                {
                  "field": "@timestamp",
                  "id": "2",
                  "settings": {
                    "interval": "auto"
                  },
                  "type": "date_histogram"
                }
              ],
              "datasource": {
                "type": "elasticsearch",
                "uid": "$es_datasource"
              },
              "metrics": [
                {
                  "id": "1",
                  "settings": {
                    "limit": "1000"
                  },
                  "type": "logs"
                }
              ],
              "query": "cubesandbox_log_source.keyword:\"component\" AND cubesandbox_component_name.keyword:$component AND cubesandbox_cluster_id.keyword:$cluster AND host_name.keyword:$node AND ($log_query)",
              "refId": "A",
              "timeField": "@timestamp"
            }
          ],
          "title": "Component log query",
          "type": "logs"
        }
      ],
      "title": "Component logs (Kubernetes Helm opt-in)",
      "type": "row"
    }
  ],
