# Installed by deploy/one-click at /etc/cube-sandbox/logrotate.d/cubesandbox
# (outside /etc/logrotate.d so the distro daily job does not also process it).
# CubeShim/CubeVMM keep logs open; use rename+create, never copytruncate.
/data/log/CubeVmm/vmm.log /data/log/CubeShim/*.log {
    hourly
    rotate 24
    missingok
    notifempty
    compress
    delaycompress
    create 0640 root root
}
