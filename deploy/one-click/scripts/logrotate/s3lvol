# Installed only when ONE_CLICK_ENABLE_S3LVOL=1.
@LOG@ {
    size 256M
    rotate 8
    missingok
    notifempty
    compress
    delaycompress
    copytruncate
    su root root
    olddir @ARCHIVE@
    # Recreate the archive directory if it disappears after install.
    createolddir 0700 root root
    # firstaction runs before any archive is renamed or compressed, so a
    # refusal leaves both the active log and the archive set untouched. Do not
    # add a prerotate guard: by then the archives have already been shifted,
    # and each refusal there would drop the oldest generation.
    firstaction
        @SPACE_CHECK@
    endscript
}
