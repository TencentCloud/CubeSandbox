[Unit]
Description=Cube Sandbox S3lvol (RCOW data plane)
After=network-online.target cube-sandbox-minio.service
Wants=network-online.target
ConditionPathExists=/usr/local/services/cubetoolbox/.one-click.env
RequiresMountsFor=/data/cubelet /data/log
# Deliberately NOT PartOf= the role targets. An upgrade stops those targets for
# its whole duration, and a stop here is a full teardown -- it disconnects the
# NVMf initiator and unloads the lvstore, which takes the block devices away
# from every live sandbox. Leaving the relationship out is what lets an upgrade
# bring this one service back on its own terms, so a sandbox is paused for that
# and not for the whole install. down.sh stops it explicitly instead.

[Service]
# Type=simple, not forking: the supervise script is the unit's main process, so
# a crash of the detached target reaches systemd as its exit.
Type=simple
EnvironmentFile=-/usr/local/services/cubetoolbox/.one-click.env
ExecStart=/usr/bin/bash /usr/local/services/cubetoolbox/scripts/systemd/cube-s3lvol-supervise.sh
# See the header of cube-s3lvol-stop.sh for the states it tells apart. Only a
# planned stop of a live target disconnects the initiator; a hot restart, and a
# target that is already gone, leave it in place so nvme_tcp reconnects to the
# rebuilt NQN/NSID grid.
ExecStop=/usr/bin/bash /usr/local/services/cubetoolbox/scripts/systemd/cube-s3lvol-stop.sh
Restart=on-failure
RestartSec=3s
# Inert as set: five restarts cannot fit the 10s default window at RestartSec=3s.
# Set StartLimitIntervalSec= to make the cap real.
StartLimitBurst=5
TimeoutStartSec=300s
# Sized to the stop scripts' worst case, not the target's exit: the scripts bound
# the work and are never signalled on timeout (see KillMode below).
TimeoutStopSec=600s
# KillMode=process, not control-group: the target is setsid-detached but still in
# this cgroup, so systemd's post-ExecStop sweep would reach it on every stop --
# including one that exits non-zero precisely to leave the target running. Mixed
# is not an alternative: its final SIGKILL reaches the cgroup too.
KillMode=process

[Install]
WantedBy=cube-sandbox-control.target
WantedBy=cube-sandbox-compute.target
