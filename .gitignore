# Rust build artifacts (per-module)
**/target/

# Go build artifacts
CubeOps/bin/
examples/volume/s3/bin/

# Go workspace (local-only, do not commit)
/go.work
/go.work.sum

# IDE
.idea/
.vscode/
*.iml

# OS
.DS_Store
Thumbs.db

# Env files
.env
*.env.local

/_output/
/Cubelet/third_party/cubecow/

# Generated protobuf Rust files (auto-generated by build.rs, do not commit)
libs/protocols/src/*.rs
runtime/libs/protocols/src/*.rs
runtime/agent/src/version.rs

# Python cache and compiled binaries in examples
API/examples/__pycache__/
API/examples/go/go
CubeAPI/examples/log.txt

# OpenAI Agents SDK examples (runtime artifacts)
examples/openai-agents-example/__pycache__/
examples/openai-agents-example/output/
examples/openai-agents-example/.scratch/
examples/openai-agents-code-interpreter/__pycache__/
examples/openai-agents-code-interpreter/output/
examples/openai-agents-code-interpreter/.scratch/

pvm-guest-build/
pvm-host-build/

# Local workdir for one-off deploy / screenshot scripts
.workdir/
# Dev notes (local only)
docs/webui-init.md
docs/dev-log.md
docs/image-1.png
docs/image.png
docs/design/

# Keep the SDK compatibility E2E suite tracked while ignoring other test
# directories and its generated local pytest cache.
__pycache__
/design
/plan
/tests/*
!/tests/e2e/
/tests/e2e/*
!/tests/e2e/sdk_compat/
!/tests/e2e/sdk_compat/**
/tests/e2e/sdk_compat/.pytest_cache/
!/tests/e2e/resource_metrics/
!/tests/e2e/resource_metrics/**

# Keep the SDK E2E skills guide tracked while ignoring other tests/skills files.
!/tests/skills/
/tests/skills/*
!/tests/skills/sdk-e2e-cases/
!/tests/skills/sdk-e2e-cases/**

# Keep the performance benchmark script tracked, but ignore everything else
# under tests/perf/ (venvs, *.log, the markdown/JSON reports the script emits),
# matching the ignore-then-un-ignore-specific-paths convention used above.
!/tests/perf/
/tests/perf/*
!/tests/perf/cubebench.sh

web/tsconfig.tsbuildinfo

# Local toolchain downloads (e.g. portable protoc)
.tools/

# Local Helm runtime values (passwords / advertiseIP / TLS). Example is tracked.
runtime-values.yaml
