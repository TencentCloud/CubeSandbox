# syntax=docker/dockerfile:1.7
#
# CubeSandbox base image: a minimal Ubuntu image with envd preinstalled so
# that sandboxes built FROM this image expose :49983/health out of the box
# and can be turned into Cube templates without any extra wiring.
#
# envd is the repository's own Rust daemon cube-envd (installed as
# /usr/bin/envd, command name kept for E2B compatibility), compiled in a
# builder stage as a static linux/${TARGETARCH} binary and copied into the
# final ubuntu:22.04 runtime stage alongside a generic entrypoint.
#
# Build from the repository root so this Dockerfile can copy cube-envd/:
#   docker build -f docker/Dockerfile.cube-base -t cubesandbox-base .
# Repeat with --platform linux/arm64 for ARM.

ARG RUST_TOOLCHAIN=1.89
ARG UBUNTU_VERSION=22.04

# -------- Stage 1: compile the local Rust envd --------
FROM rust:${RUST_TOOLCHAIN}-slim-bookworm AS envd-builder

ARG RUST_TOOLCHAIN
ARG TARGETARCH
ARG CUBE_ENVD_VERSION=0.1.0
ARG CUBE_ENVD_COMMIT=unknown

RUN set -eux; \
    arch="${TARGETARCH:-$(dpkg --print-architecture)}"; \
    case "${arch}" in \
      amd64|x86_64) rust_target=x86_64-unknown-linux-musl ;; \
      arm64|aarch64) rust_target=aarch64-unknown-linux-musl ;; \
      *) echo "unsupported target architecture: ${arch}" >&2; exit 1 ;; \
    esac; \
    echo "${rust_target}" > /tmp/rust-target; \
    apt-get update; \
    apt-get install -y --no-install-recommends musl-tools; \
    rm -rf /var/lib/apt/lists/*; \
    rustup target add "${rust_target}" --toolchain "${RUST_TOOLCHAIN}"

WORKDIR /src/cube-envd

COPY cube-envd/Cargo.toml cube-envd/Cargo.lock cube-envd/rust-toolchain.toml cube-envd/build.rs ./
COPY cube-envd/proto/ proto/
COPY cube-envd/src/ src/

RUN --mount=type=cache,target=/usr/local/cargo/registry \
    rust_target="$(cat /tmp/rust-target)"; \
    CUBE_ENVD_VERSION="${CUBE_ENVD_VERSION}" CUBE_ENVD_COMMIT="${CUBE_ENVD_COMMIT}" \
      cargo "+${RUST_TOOLCHAIN}" build --release --locked --target "${rust_target}" --bin cube-envd; \
    install -Dm0755 "target/${rust_target}/release/cube-envd" /out/envd; \
    /out/envd -version; \
    /out/envd -commit

# -------- Stage 2: runtime image --------
FROM ubuntu:${UBUNTU_VERSION}

ARG DEBIAN_FRONTEND=noninteractive
ARG CUBE_ENVD_VERSION=0.1.0
ARG CUBE_ENVD_COMMIT=unknown

ENV ENVD_PORT=49983 \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        sudo \
        tini \
        util-linux \
    && rm -rf /var/lib/apt/lists/*

# Requests without an Authorization header run as root, matching the Go
# envd default (defaultUser = "root"). SDK clients older than envd 0.4.0
# send "Basic user:", which resolves to the uid 1000 account provisioned
# below; newer SDKs omit the header and therefore run as root.
RUN useradd --create-home --uid 1000 --shell /bin/bash user \
    && echo 'user ALL=(ALL) NOPASSWD:ALL' > /etc/sudoers.d/user \
    && chmod 0440 /etc/sudoers.d/user

COPY --from=envd-builder /out/envd /usr/bin/envd
COPY docker/cube-entrypoint.sh /usr/local/bin/cube-entrypoint.sh

RUN chmod +x /usr/bin/envd /usr/local/bin/cube-entrypoint.sh \
    && mkdir -p /var/log \
    && /usr/bin/envd -version \
    && /usr/bin/envd -commit

LABEL org.opencontainers.image.source="https://github.com/TencentCloud/CubeSandbox" \
      org.opencontainers.image.title="cubesandbox-base" \
      org.opencontainers.image.description="CubeSandbox base image with Rust cube-envd" \
      org.opencontainers.image.licenses="Apache-2.0" \
      io.cubesandbox.envd.version="${CUBE_ENVD_VERSION}" \
      io.cubesandbox.envd.commit="${CUBE_ENVD_COMMIT}"

EXPOSE 49983

ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/cube-entrypoint.sh"]
CMD []
