# syntax=docker/dockerfile:1.7
#
# CubeSandbox base image: a minimal Ubuntu image with envd preinstalled so
# that sandboxes built FROM this image expose :49983/health out of the box
# and can be turned into Cube templates without any extra wiring.
#
# Two envd implementations are built and both are shipped:
#   * /usr/bin/envd     — the selected implementation (default: cube-envd)
#   * /usr/bin/envd-go  — the upstream Go envd pinned by ENVD_REF
# `ENVD_IMPL=cube|go` picks which one becomes /usr/bin/envd (build-time),
# and `ENVD_BIN=/usr/bin/envd-go` switches back at runtime without a rebuild.
# The literal path /usr/bin/envd matters: Cubelet collects the envd version by
# exec'ing `envd --version`, so an ENVD_BIN override alone would leave the
# template annotated with the other implementation's version.
#
# Build from the repository root so this Dockerfile can copy cube-envd/:
#   docker build -f docker/Dockerfile.cube-base -t cubesandbox-base .
# Repeat with --platform linux/arm64 for ARM.
#
# The envd version always comes from cube-envd/src/version.rs, so the build
# above already produces a correctly versioned binary. To also stamp the
# io.cubesandbox.envd.version label, pass that same constant (the build fails
# if the two disagree):
#   docker build -f docker/Dockerfile.cube-base -t cubesandbox-base \
#     --build-arg CUBE_ENVD_VERSION="$(sed -n \
#       's/.*CUBE_ENVD_VERSION: &str = "\([^"]*\)".*/\1/p' \
#       cube-envd/src/version.rs | head -1)" .

ARG RUST_TOOLCHAIN=1.89
ARG GO_VERSION=1.25.4
ARG UBUNTU_VERSION=22.04
# 选择 /usr/bin/envd 的实现：cube（默认）或 go。两者都会进镜像。
ARG ENVD_IMPL=cube
ARG ENVD_REF=2026.16

# -------- Stage 1a: compile the upstream Go envd (pinned ENVD_REF) --------
# 始终构建并安装为 /usr/bin/envd-go：这是运行期回滚的落点，删掉它回滚就需要重建镜像。
FROM golang:${GO_VERSION}-bookworm AS envd-go-builder

ARG ENVD_REF
ARG TARGETARCH
ARG ENVD_UPSTREAM_REPO=https://github.com/e2b-dev/infra.git
# 模块代理可按需覆盖：默认走官方代理（GitHub Actions 上可用），
# 网络受限的构建环境用 --build-arg GOPROXY=https://goproxy.cn,direct 切换。
ARG GOPROXY=https://proxy.golang.org,direct
ENV GOPROXY=${GOPROXY}

RUN apt-get update \
    && apt-get install -y --no-install-recommends git ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /src

RUN git clone --depth 1 --branch "${ENVD_REF}" "${ENVD_UPSTREAM_REPO}" infra

WORKDIR /src/infra/packages/envd

RUN --mount=type=cache,target=/root/.cache/go-build \
    --mount=type=cache,target=/go/pkg/mod \
    commit_sha="$(git -C /src/infra rev-parse --short HEAD)" \
    && echo "Building envd from ${ENVD_UPSTREAM_REPO}@${ENVD_REF} (commit=${commit_sha})" \
    && CGO_ENABLED=0 GOOS=linux GOARCH=${TARGETARCH:-amd64} \
       go build -a \
           -ldflags "-X=main.commitSHA=${commit_sha} -s -w" \
           -o /out/envd \
           . \
    && chmod +x /out/envd \
    && /out/envd -version \
    && /out/envd -commit

# -------- Stage 1b: compile the local Rust envd --------
FROM rust:${RUST_TOOLCHAIN}-slim-bookworm AS envd-cube-builder

ARG RUST_TOOLCHAIN
ARG TARGETARCH
# 版本唯一事实源是 cube-envd/src/version.rs 的常量，它**不**注入 cargo 构建环境，
# 因此任何构建渠道（包括不带 --build-arg 的手工 docker build）产出的二进制都自报
# 同一个真 semver。CUBE_ENVD_VERSION 只用于镜像 LABEL，并在非空时与二进制自报版本
# 比对：label 要么正确、要么缺省，不会出现"标签与产物分叉"。
#
# 注意 Docker 会把阶段内声明的 ARG 作为环境变量注入每个 RUN，`option_env!` 会因此
# 读到它，所以构建步骤里必须显式 unset——否则"去掉注入"是假的，二进制依旧跟着
# build-arg 走，而校验也就退化成恒真式。
ARG CUBE_ENVD_VERSION=
ARG CUBE_ENVD_COMMIT=unknown

RUN set -eux; \
    arch="${TARGETARCH:-$(dpkg --print-architecture)}"; \
    case "${arch}" in \
      amd64|x86_64) rust_target=x86_64-unknown-linux-musl ;; \
      arm64|aarch64) rust_target=aarch64-unknown-linux-musl ;; \
      *) echo "unsupported target architecture: ${arch}" >&2; exit 1 ;; \
    esac; \
    echo "${rust_target}" > /tmp/rust-target; \
    apt-get update; \
    apt-get install -y --no-install-recommends musl-tools; \
    rm -rf /var/lib/apt/lists/*; \
    rustup target add "${rust_target}" --toolchain "${RUST_TOOLCHAIN}"

WORKDIR /src/cube-envd

COPY cube-envd/Cargo.toml cube-envd/Cargo.lock cube-envd/rust-toolchain.toml cube-envd/build.rs ./
COPY cube-envd/proto/ proto/
COPY cube-envd/src/ src/

RUN --mount=type=cache,target=/usr/local/cargo/registry \
    rust_target="$(cat /tmp/rust-target)"; \
    wanted_version="${CUBE_ENVD_VERSION}"; \
    unset CUBE_ENVD_VERSION; \
    CUBE_ENVD_COMMIT="${CUBE_ENVD_COMMIT}" \
      cargo "+${RUST_TOOLCHAIN}" build --release --locked --target "${rust_target}" --bin cube-envd; \
    install -Dm0755 "target/${rust_target}/release/cube-envd" /out/envd; \
    reported="$(/out/envd -version)"; \
    if [ -n "${wanted_version}" ] && [ "${reported}" != "${wanted_version}" ]; then \
        echo "CUBE_ENVD_VERSION (${wanted_version}) does not match the version the binary reports (${reported});" >&2; \
        echo "the version is the constant in cube-envd/src/version.rs — pass that value, or leave the build arg empty" >&2; \
        exit 1; \
    fi; \
    /out/envd -version; \
    /out/envd -commit

# -------- Stage 1c: select which implementation is the default --------
# envd-${ENVD_IMPL}-builder 解析为 envd-cube-builder（默认）或 envd-go-builder。
FROM envd-${ENVD_IMPL}-builder AS envd-default

# -------- Stage 2: runtime image --------
FROM ubuntu:${UBUNTU_VERSION}

ARG ENVD_IMPL=cube
ARG ENVD_REF=2026.16

ARG DEBIAN_FRONTEND=noninteractive
# 只影响 LABEL：留空则不打版本 label（二进制仍自报源码常量），非空时会与二进制
# 自报版本校验一致后才允许构建。
ARG CUBE_ENVD_VERSION=
ARG CUBE_ENVD_COMMIT=unknown

ENV ENVD_PORT=49983 \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        sudo \
        tini \
        util-linux \
    && rm -rf /var/lib/apt/lists/*

# Requests without an Authorization header run as root, matching the Go
# envd default (defaultUser = "root"). SDK clients older than envd 0.4.0
# send "Basic user:", which resolves to the uid 1000 account provisioned
# below; newer SDKs omit the header and therefore run as root.
RUN useradd --create-home --uid 1000 --shell /bin/bash user \
    && echo 'user ALL=(ALL) NOPASSWD:ALL' > /etc/sudoers.d/user \
    && chmod 0440 /etc/sudoers.d/user

COPY --from=envd-default /out/envd /usr/bin/envd
COPY --from=envd-go-builder /out/envd /usr/bin/envd-go
COPY docker/cube-entrypoint.sh /usr/local/bin/cube-entrypoint.sh

RUN chmod +x /usr/bin/envd /usr/bin/envd-go /usr/local/bin/cube-entrypoint.sh \
    && mkdir -p /var/log \
    && printf '%s\n' "${ENVD_IMPL}" > /etc/cubesandbox-envd-impl \
    && printf '%s\n' "${ENVD_REF}" > /etc/cubesandbox-envd-ref \
    && echo "default envd implementation: $(cat /etc/cubesandbox-envd-impl)" \
    && /usr/bin/envd -version \
    && /usr/bin/envd -commit \
    && /usr/bin/envd-go -version \
    && /usr/bin/envd-go -commit

LABEL org.opencontainers.image.source="https://github.com/TencentCloud/CubeSandbox" \
      org.opencontainers.image.title="cubesandbox-base" \
      org.opencontainers.image.description="CubeSandbox base image with Rust cube-envd" \
      org.opencontainers.image.licenses="Apache-2.0" \
      io.cubesandbox.envd.version="${CUBE_ENVD_VERSION}" \
      io.cubesandbox.envd.commit="${CUBE_ENVD_COMMIT}" \
      io.cubesandbox.envd.impl="${ENVD_IMPL}" \
      io.cubesandbox.envd.ref="${ENVD_REF}"

EXPOSE 49983

ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/cube-entrypoint.sh"]
CMD []
