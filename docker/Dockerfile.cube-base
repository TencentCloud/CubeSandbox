# syntax=docker/dockerfile:1.7
#
# CubeSandbox base image: a minimal Ubuntu image with the local Rust
# cube-envd preinstalled so that sandboxes built FROM it expose
# :49983/health out of the box.
#
# Build from the repository root (the build context must include cube-envd/):
#   docker build -f docker/Dockerfile.cube-base -t cubesandbox-base:local .
# or: make build-cube-base-image

ARG UBUNTU_VERSION=22.04

# -------- Stage 1: compile cube-envd (Rust) --------
FROM rust:1.89-bookworm AS envd-builder

# Injected by CI/Makefile so `envd -commit` reports the source revision even
# though .git is excluded from the Docker build context. Empty falls back to
# `git rev-parse` in build.rs.
ARG CUBE_ENVD_COMMIT
ENV CUBE_ENVD_COMMIT=${CUBE_ENVD_COMMIT}

WORKDIR /src
COPY cube-envd/ ./cube-envd/

RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/usr/local/cargo/git \
    --mount=type=cache,target=/src/cube-envd/target \
    cd cube-envd \
    && cargo build --release \
    && mkdir -p /out \
    && install -m 0755 target/release/cube-envd /out/envd \
    && /out/envd -version \
    && /out/envd -commit

FROM ubuntu:${UBUNTU_VERSION}

ARG ENVD_IMPL=cube-envd

ENV ENVD_IMPL=${ENVD_IMPL} \
    ENVD_PORT=49983 \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        sudo \
        tini \
    && rm -rf /var/lib/apt/lists/*

RUN useradd --create-home --uid 1000 --shell /bin/bash user \
    && echo 'user ALL=(ALL) NOPASSWD:ALL' > /etc/sudoers.d/user \
    && chmod 0440 /etc/sudoers.d/user

COPY --from=envd-builder /out/envd /usr/bin/envd
COPY docker/cube-entrypoint.sh /usr/local/bin/cube-entrypoint.sh

RUN chmod +x /usr/bin/envd /usr/local/bin/cube-entrypoint.sh \
    && mkdir -p /var/log \
    && /usr/bin/envd -version \
    && /usr/bin/envd -commit

LABEL org.opencontainers.image.source="https://github.com/TencentCloud/CubeSandbox" \
      org.opencontainers.image.title="cubesandbox-base" \
      org.opencontainers.image.description="CubeSandbox base image with cube-envd" \
      org.opencontainers.image.licenses="Apache-2.0" \
      io.cubesandbox.envd.impl="cube-envd-rust"

EXPOSE 49983

ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/cube-entrypoint.sh"]
CMD []
